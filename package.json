{
  "name": "@odience/paperclip-plugin-cubesandbox",
  "version": "2.0.0",
  "description": "Paperclip sandbox-provider environment driver for self-hosted Tencent CubeSandbox",
  "license": "MIT",
  "author": "Odience",
  "homepage": "https://github.com/odience-network/paperclip-plugin-cubesandbox",
  "bugs": {
    "url": "https://github.com/odience-network/paperclip-plugin-cubesandbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/odience-network/paperclip-plugin-cubesandbox.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "sandbox",
    "cubesandbox",
    "environment-driver"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "e2b": "^2.51.0"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "^2026.916.1"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.916.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
